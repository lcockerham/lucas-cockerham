---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Lucas Cockerham — Strategic Director of Engineering with 20 years of experience building high-performing teams.' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === 'Lucas Cockerham' ? title : `${title} — Lucas Cockerham | Director of Engineering`;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/experience', label: 'Experience' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <title>{fullTitle}</title>
  </head>
  <body class="bg-white text-gray-900 min-h-screen flex flex-col font-sans antialiased">

    <header class="border-b border-gray-200 sticky top-0 bg-white z-10">
      <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
        <a href="/" class="text-sm font-bold tracking-widest uppercase no-underline hover:text-gray-600 transition-colors">
          Lucas Cockerham
        </a>
        <nav class="hidden md:flex items-center gap-8">
          {navLinks.map(({ href, label }) => (
            <a
              href={href}
              class={`text-sm transition-colors ${
                (href === '/' ? currentPath === '/' : currentPath.startsWith(href))
                  ? 'text-gray-900 font-semibold'
                  : 'text-gray-500 hover:text-gray-900'
              }`}
            >
              {label}
            </a>
          ))}
        </nav>
        <!-- Mobile menu placeholder: nav links shown inline on small screens -->
        <nav class="flex md:hidden items-center gap-4">
          {navLinks.map(({ href, label }) => (
            <a href={href} class="text-xs text-gray-500 hover:text-gray-900 transition-colors">{label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-gray-200 mt-16">
      <div class="max-w-5xl mx-auto px-6 py-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div>
          <p class="font-semibold text-gray-900">Lucas Cockerham</p>
          <p class="text-sm text-gray-500">Director of Engineering</p>
        </div>
        <div class="flex items-center gap-4">
          <a href="https://www.linkedin.com/in/lucas-cockerham-081a3b41/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-gray-400 hover:text-gray-900 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a href="https://github.com/lcockerham" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="text-gray-400 hover:text-gray-900 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
            </svg>
          </a>
        </div>
        <div class="text-sm text-gray-500">
          <p class="font-medium text-gray-700 mb-1">My other websites</p>
          <div class="flex gap-3">
            <a href="https://theporemansjournal.com" target="_blank" rel="noopener noreferrer" class="hover:text-gray-900 transition-colors">The Poreman's Journal</a>
            <span>•</span>
            <a href="https://thegiantsbane.com" target="_blank" rel="noopener noreferrer" class="hover:text-gray-900 transition-colors">The Giantsbane</a>
          </div>
        </div>
      </div>
      <div class="max-w-5xl mx-auto px-6 pb-6">
        <p class="text-xs text-gray-400">© {new Date().getFullYear()} All rights reserved.</p>
      </div>
    </footer>

  </body>
</html>
