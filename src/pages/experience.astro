---
import BaseLayout from '../layouts/BaseLayout.astro';

const jobs = [
  {
    title: 'Director, Software Engineering',
    company: 'OpenText Communications (fka Exstream)',
    period: 'Jan 2025 – Present',
    location: 'Lexington, KY',
    bullets: [
      'Leading a team of 70+ engineers to support and enhance the market-leading Customer Communications Management (CCM) platform.',
      'Driving focus on customer management and experience to improve client satisfaction and product adoption.',
      'Leading AI transformation initiatives to integrate intelligent automation and next-generation capabilities.',
    ],
    tags: ['AI/ML', 'Cloud Architecture', 'Team Leadership', 'CCM', 'Customer Experience'],
  },
  {
    title: 'Senior Manager, Software Engineering',
    company: 'dbt Labs',
    period: 'Dec 2022 – Aug 2024',
    location: 'Richmond, KY (Remote)',
    bullets: [
      'Managing internal services and release engineering teams, focusing on scalability and reliability.',
      'Leading cross-functional teams through a major cellular architecture migration to improve system resilience.',
      'Improving engineering efficiency through optimized CI/CD pipelines and developer tooling.',
    ],
    tags: ['Python', 'Kubernetes', 'AWS', 'Terraform', 'Distributed Systems'],
  },
  {
    title: 'Senior Manager, Software Engineering',
    company: 'HP / OpenText Exstream',
    period: 'Jan 2014 – Dec 2022',
    location: 'Lexington, KY',
    bullets: [
      'Built and scaled engineering teams from the ground up, establishing hiring practices and culture.',
      'Led the organization\'s adoption of Agile methodologies, transitioning from Waterfall to Scrum.',
      'Managed complex cloud environments and directed the modernization of legacy enterprise software.',
    ],
    tags: ['Java', 'C++', 'Azure', 'Jenkins', 'Scrum', 'Management'],
  },
  {
    title: 'Systems Development Director',
    company: 'Xerox Commercial Services',
    period: '2010 – 2013',
    location: 'Lexington, KY',
    bullets: [
      'Directed large engineering organizations and managed key customer relationships.',
      'Served as Solution Architect and Development Manager, driving ITIL process adoption.',
      'Oversaw the delivery of critical business systems in the healthcare and transportation sectors.',
    ],
    tags: ['.NET', 'SQL Server', 'ITIL', 'Enterprise Architecture'],
  },
];

const ventures = [
  {
    title: 'Rental Cabin LLC',
    role: 'Owner & Operator',
    desc: 'Operating and managing vacation rental property business.',
  },
  {
    title: 'University of Kentucky',
    role: 'Part-Time Instructor • Fall 2024',
    desc: 'Teaching graduate-level Data Science course.',
  },
  {
    title: 'Chomp LLC',
    role: 'Owner & Operator • May 2019 – Dec 2020',
    desc: 'Founded and operated food truck business.',
  },
];
---

<BaseLayout title="Experience" description="Lucas Cockerham's professional experience — a track record of building teams and shipping software.">
  <div class="max-w-5xl mx-auto px-6 py-16">

    <!-- Page header -->
    <div class="mb-16">
      <h1 class="text-5xl font-black tracking-tight mb-4">Experience</h1>
      <p class="text-gray-500 text-lg">A track record of building teams and shipping software.</p>
    </div>

    <!-- Work history -->
    <div class="space-y-10 mb-20">
      {jobs.map((job) => (
        <div class="border border-gray-200 rounded-2xl p-8">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-2 mb-4">
            <div>
              <h2 class="text-xl font-bold text-gray-900">{job.title}</h2>
              <p class="text-gray-600 font-medium">{job.company}</p>
            </div>
            <div class="text-right shrink-0">
              <p class="text-sm font-semibold text-gray-700">{job.period}</p>
              <p class="text-sm text-gray-500">{job.location}</p>
            </div>
          </div>
          <ul class="space-y-2 mb-6">
            {job.bullets.map((b) => (
              <li class="text-gray-600 text-sm leading-relaxed flex gap-2">
                <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-gray-400 shrink-0"></span>
                <span>{b}</span>
              </li>
            ))}
          </ul>
          <div class="flex flex-wrap gap-2">
            {job.tags.map((tag) => (
              <span class="px-3 py-1 bg-gray-100 text-gray-600 rounded-full text-xs font-medium">{tag}</span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Ventures & Teaching -->
    <div>
      <h2 class="text-2xl font-bold mb-6">Ventures &amp; Teaching</h2>
      <div class="grid sm:grid-cols-3 gap-6">
        {ventures.map((v) => (
          <div class="border border-gray-200 rounded-2xl p-6">
            <h3 class="font-bold text-gray-900 mb-1">{v.title}</h3>
            <p class="text-sm text-gray-500 mb-3">{v.role}</p>
            <p class="text-sm text-gray-600 leading-relaxed">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>

  </div>
</BaseLayout>
