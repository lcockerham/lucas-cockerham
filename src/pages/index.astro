---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Lucas Cockerham">
  <!-- Hero -->
  <section class="max-w-5xl mx-auto px-6 py-20 md:py-28">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div>
        <h1 class="text-5xl md:text-6xl font-black leading-tight tracking-tight mb-6">
          Leading Engineering Teams to <span class="inline-block">Excellence</span>
        </h1>
        <p class="text-gray-500 text-lg leading-relaxed mb-8">
          Strategic Director of Engineering with 20 years of experience building high-performing teams,
          driving Agile transformation, and delivering scalable cloud solutions.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/contact" class="inline-flex items-center gap-2 bg-gray-900 text-white px-6 py-3 rounded-full font-semibold hover:bg-gray-700 transition-colors">
            Get in Touch &rarr;
          </a>
          <a href="/experience" class="inline-flex items-center gap-2 border border-gray-300 text-gray-900 px-6 py-3 rounded-full font-semibold hover:border-gray-900 transition-colors">
            View Experience
          </a>
        </div>
      </div>
      <div class="flex justify-center md:justify-end">
        <div class="w-72 h-72 md:w-80 md:h-80 rounded-full overflow-hidden border-4 border-white shadow-xl ring-1 ring-gray-200">
          <img
            src="/lucas-cockerham.jpg"
            alt="Lucas Cockerham"
            class="w-full h-full object-cover object-top"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Core Competencies -->
  <section class="bg-gray-50 py-20">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-3xl font-bold text-center mb-12">Core Competencies</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <div class="w-10 h-10 rounded-xl bg-gray-100 flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0" />
            </svg>
          </div>
          <h3 class="font-bold text-gray-900 mb-2">Leadership &amp; Culture</h3>
          <p class="text-sm text-gray-500 leading-relaxed">Building psychological safety, mentoring engineers, and fostering a culture of accountability and innovation.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <div class="w-10 h-10 rounded-xl bg-gray-100 flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
            </svg>
          </div>
          <h3 class="font-bold text-gray-900 mb-2">Technical Strategy</h3>
          <p class="text-sm text-gray-500 leading-relaxed">Guiding cloud migrations (AWS, Azure), microservices architecture, and modernizing legacy systems.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <div class="w-10 h-10 rounded-xl bg-gray-100 flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="font-bold text-gray-900 mb-2">Agile &amp; Delivery</h3>
          <p class="text-sm text-gray-500 leading-relaxed">Implementing Scrum/Kanban at scale, optimizing CI/CD pipelines, and ensuring predictable delivery.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <div class="w-10 h-10 rounded-xl bg-gray-100 flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17H3a2 2 0 01-2-2V5a2 2 0 012-2h14a2 2 0 012 2v10a2 2 0 01-2 2h-2" />
            </svg>
          </div>
          <h3 class="font-bold text-gray-900 mb-2">AI Engineering</h3>
          <p class="text-sm text-gray-500 leading-relaxed">Applying data science, neural networks, and practical LLM tools to solve real-world engineering challenges.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
